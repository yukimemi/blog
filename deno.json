{
  "//": "The site is built by Zola plus tools/postprocess (see build.sh). Deno is kept only for the authoring helpers in scripts/.",
  "tasks": {
    "fmt": {
      "description": "Format the code",
      "command": "deno fmt"
    },
    "zenn": {
      "description": "Copy a post to Zenn directory",
      "command": "deno run -A scripts/copy_to_zenn.ts"
    },
    "new": {
      "description": "Create a new post",
      "command": "deno run -A scripts/new_post.ts"
    }
  },
  "fmt": {
    "exclude": [
      "content/",
      "public/",
      "templates/",
      "AGENTS.md",
      "CLAUDE.md",
      "GEMINI.md",
      "OPENCODE.md",
      "README.md",
      "apm.yml",
      "apm.lock.yaml",
      ".agents/",
      ".claude/",
      ".gemini/",
      ".kata/",
      "renri.toml",
      "renovate.json",
      "opencode.json"
    ]
  },
  "lock": false
}
